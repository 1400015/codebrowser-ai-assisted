{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client"],
    "isolatedModules": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
